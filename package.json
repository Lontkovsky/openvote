{
  "name": "openvote",
  "version": "0.1.0-dev.1",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:demand": "node --env-file=.env scripts/demand-dev.ts",
    "render:start": "node scripts/render-start.ts",
    "demand:start": "node scripts/demand-start.ts",
    "seed": "node scripts/seed.ts",
    "test": "vitest run",
    "test:e2e": "node scripts/e2e.mjs",
    "smoke": "node scripts/smoke.ts",
    "test:crypto": "sh scripts/test-reference.sh",
    "verify": "sh scripts/verify.sh",
    "observer": "node scripts/observer.ts",
    "audit:export": "node scripts/audit-export.ts",
    "mirror:export": "node scripts/mirror-export.ts",
    "recovery:verify": "node scripts/recovery-verify.ts",
    "load:test": "node scripts/load-test.ts",
    "release:verify": "node scripts/reproducible-release.ts",
    "client:monitor": "node scripts/client-monitor.ts",
    "lint": "python3 scripts/scan-public.py && git diff --check",
    "types": "tsc --noEmit",
    "build": "pnpm --filter @openvote/web build",
    "build:demand": "pnpm --filter @openvote/web build:demand",
    "migrate": "node scripts/migrate.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.8",
    "fastify": "5.12.7",
    "pg": "8.23.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "fast-check": "4.9.0",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
